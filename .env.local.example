# Copy this file to ".env.local" (same folder) and fill in your own values.
# ".env.local" is already git-ignored, so your keys never get committed.

# --- Supabase ---------------------------------------------------------
# Find these in your Supabase project: Settings -> API
# Project URL:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# "anon" / "public" key (safe to expose in the browser):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# "service_role" key — SERVER ONLY, never prefix with NEXT_PUBLIC_.
# Only needed if you later add server actions / API routes that must
# bypass Row Level Security. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- App login (temporary, hardcoded auth) -----------------------------
# Used by lib/auth.ts until Supabase Auth is wired up. Optional — if left
# blank, the defaults baked into lib/auth.ts are used instead.
APP_LOGIN_EMAIL=admin@stockbase.app
APP_LOGIN_PASSWORD=change-this-password
